<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ChatController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="5.0" />
    </padding>
    <VBox>
        <Label fx:id="messageLabel" text="MEK Chat" />
        <ListView fx:id="messageView" prefWidth="247.0" />
        <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
        </padding>
    </VBox>

    <HBox alignment="BOTTOM_RIGHT" prefHeight="0.0" prefWidth="247.0" spacing="3.0">
        <opaqueInsets>
            <Insets />
        </opaqueInsets>
        <TextField fx:id="inputField" maxWidth="Infinity" HBox.hgrow="ALWAYS">
         <opaqueInsets>
            <Insets />
         </opaqueInsets></TextField>
        <Button fx:id="sendButton" maxHeight="Infinity" onAction="#sendMessage">
            <graphic>
                <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                    <Image url="@send.png" />
                </ImageView>
            </graphic>
        </Button>
      <padding>
         <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
      </padding>

    </HBox>
</VBox>
